package bettyblocks:smtp@0.2.0;

interface client {
    record credentials {
        host: string,
        port: option<u16>,
        username: option<string>,
        password: option<string>,
        /// - none: No TLS (plaintext, port 25).
        /// - starttls: Explicit TLS via STARTTLS (port 587)
        /// - implicit: Implicit TLS (port 465).
        tls-mode: tls-mode,
    }

    enum tls-mode {
        none,
        starttls,
        implicit,
    }

    record sender {
        %from: string,
        reply-to: option<string>,
        name: option<string>,
    }

    record recipient {
        to: list<string>,
        cc: option<list<string>>,
        bcc: option<list<string>>,
    }

    record attachment {
        filename: string,
        content-type: string,
        content: list<u8>,
    }

    record message {
        sender: sender,
        recipient: recipient,
        subject: string,
        body: string,
        attachments: option<list<attachment>>,
    }

    record send-result {
        accepted: bool,
        server: option<string>,
        message-id: option<string>,
    }

    resource smtp-client {
        connect: static func(creds: credentials) -> result<smtp-client, string>;
        send: func(msg: message) -> result<send-result, string>;
        disconnect: func() -> result<_, string>;
    }
}